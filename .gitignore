### ---------------------------------------------------------------------------------------------
### Secrets — keep this block first; it is the only part of this file that is security-relevant.
### ---------------------------------------------------------------------------------------------

# local.properties holds sdk.dir AND the two real API keys (MAPS_API_KEY, PLANTNET_API_KEY).
# It must never be committed. Both a rooted and an unrooted pattern, so a copy in a subdirectory
# is caught too.
/local.properties
local.properties

# NOTE: local.defaults.properties is deliberately NOT ignored. It is the committed placeholder file
# the Secrets Gradle Plugin falls back to, and it contains only YOUR_KEY_HERE-style values. The
# patterns above match the literal name "local.properties" only, so they cannot catch it.

# Signing material. None exists in this project today (debug builds use the auto-generated debug
# keystore in ~/.android), but a release key must never land here.
*.jks
*.keystore
*.p12
*.pfx
*.pepk
keystore.properties
signing.properties

# Service-account / OAuth blobs that Android tooling likes to drop into the project root.
google-services.json
.env
.env.*

