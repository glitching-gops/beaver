### Android build outputs
### ---------------------------------------------------------------------------------------------
*.apk
*.aab
*.ap_
*.aar
*.dex
*.class
bin/
gen/
out/
release/
/captures
captures/

# Native build artifacts (this project has no NDK sources, but AGP still creates these dirs when a
# dependency ships prefabs).
.externalNativeBuild/
.cxx/

# Lint / test reports are regenerated on every run.
lint-results*.html
lint-results*.xml

### ---------------------------------------------------------------------------------------------
### IntelliJ / Android Studio
### ---------------------------------------------------------------------------------------------
*.iml
.kotlin/

# Ignore the machine-specific parts of .idea and keep the sensible shared subset
# (codeStyles/, inspectionProfiles/, and the portable $PROJECT_DIR$-relative project files).
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/dictionaries/
.idea/shelf/
.idea/caches/
.idea/libraries/
.idea/modules/
.idea/modules.xml
.idea/*.iml
.idea/navEditor.xml
.idea/assetWizardSettings.xml
.idea/jarRepositories.xml
.idea/deploymentTargetSelector.xml
.idea/deploymentTargetDropDown.xml
.idea/androidTestResultsUserPreferences.xml
.idea/sonarlint/
.idea/httpRequests/

# Per-developer Claude Code tool permissions. Harmless, but personal to one machine — the shared
# .claude/settings.json (if one is ever added) is the file meant to be committed.
.claude/settings.local.json

### ---------------------------------------------------------------------------------------------
### Field data
### ---------------------------------------------------------------------------------------------

# Capture photos written by the app carry GPS EXIF from wherever they were shot. One has been left
# in the project root during development; ignoring the pattern keeps survey photos out of a public
# repo by default.
/SpatialMapper_*.jpg
*.hprof

