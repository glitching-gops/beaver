<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Species identification posts a close-up photo to the Pl@ntNet API. Both are normal
         (install-time) permissions, so there is no runtime request to make. ACCESS_NETWORK_STATE lets
         us say "no internet connection" up front instead of after a socket timeout — identification is
         explicitly a whenever-convenient action, so being offline is expected, not exceptional. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ARCore is optional: the app must still install and run (in geometry-fallback mode) on
         devices without ARCore/Depth support, per the "any Android 14+ device" requirement. -->
    <uses-feature android:name="android.hardware.camera.ar" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SpatialMapper">

        <!-- "optional" (not "required") so Google Play does not restrict install to ARCore
             devices, and ARCore is only used when actually available at runtime. -->
        <meta-data android:name="com.google.ar.core" android:value="optional" />

        <!-- Google Maps SDK for Android API key. The value is a placeholder substituted at build
             time by the Secrets Gradle Plugin from MAPS_API_KEY in local.properties — never a real
             key committed here. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SpatialMapper">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>